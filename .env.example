# Ключ GigaChat (Authorization Key из личного кабинета GigaChat).
# Нужен ТОЛЬКО на сервере: его читают server.ts, backend-server.js и api/gigachat.ts (Vercel).
#
# Локальный запуск: скопируйте этот файл в .env и вставьте свой ключ.
# В git файл .env не попадает (исключён через .gitignore).
# На Vercel/Render ключ задаётся в настройках проекта как переменная окружения.
GIGACHAT_API_KEY="ваш-authorization-key"

# Порт автономного прокси backend-server.js (по умолчанию 3001)
# PORT=3001
